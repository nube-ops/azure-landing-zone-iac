using './main.bicep'

/*
  ==============================================================================
  AZURE ENTERPRISE REGIONAL PAIRS & CODES REFERENCE
  ==============================================================================
  Use this reference guide when mapping out your multi-region deployment topology:
  
  Primary Region      | Short Code | Paired Region       | Paired Code
  --------------------+------------+---------------------+------------
  centralus           | cus        | eastus2             | eus2
  eastus              | eus        | westus2             | wus2
  westus              | wus        | eastus              | eus
  northcentralus      | ncus       | southcentralus      | scus
  southcentralus      | scus       | northcentralus      | ncus
  westus2             | wus2       | westus              | wus
  eastus2             | eus2       | centralus           | cus
  ==============================================================================
*/

// ==========================================
// SINGLE SOURCE OF TRUTH (DRY Configuration)
// ==========================================
param orgName = 'contoso'
param geoPrefix = 'us'

// Computed structural prefixes
var rootMgName = 'mg-${orgName}-${geoPrefix}'

param regionalConfig = [
  {
    location: 'centralus'
    regionCode: 'cus'
    isPrimary: true   // Explicitly designated as the primary region
  }
  {
    location: 'eastus2'
    regionCode: 'eus2'
    isPrimary: false  // Failover / secondary region
  }
]

// ==========================================
// Management Group Hierarchy (Topology Mapping)
// ==========================================

param managementGroups = [
  {
    name: rootMgName
    displayName: '${toUpper(orgName)} ${toUpper(geoPrefix)} Organization Root'
    parentMgId: '' // Resolved dynamically in main.bicep
  }
  {
    name: '${rootMgName}-landingzones'
    displayName: '${toUpper(orgName)} ${toUpper(geoPrefix)} Landing Zones'
    parentMgId: '/providers/Microsoft.Management/managementGroups/${rootMgName}'
  }
  {
    name: '${rootMgName}-corp'
    displayName: '${toUpper(orgName)} ${toUpper(geoPrefix)} Corp'
    parentMgId: '/providers/Microsoft.Management/managementGroups/${rootMgName}-landingzones'
  }
  {
    name: '${rootMgName}-online'
    displayName: '${toUpper(orgName)} ${toUpper(geoPrefix)} Online'
    parentMgId: '/providers/Microsoft.Management/managementGroups/${rootMgName}-landingzones'
  }
  {
    name: '${rootMgName}-platform'
    displayName: '${toUpper(orgName)} ${toUpper(geoPrefix)} Platform'
    parentMgId: '/providers/Microsoft.Management/managementGroups/${rootMgName}'
  }
  {
    name: '${rootMgName}-connectivity'
    displayName: '${toUpper(orgName)} ${toUpper(geoPrefix)} Connectivity'
    parentMgId: '/providers/Microsoft.Management/managementGroups/${rootMgName}-platform'
  }
  {
    name: '${rootMgName}-identity'
    displayName: '${toUpper(orgName)} ${toUpper(geoPrefix)} Identity'
    parentMgId: '/providers/Microsoft.Management/managementGroups/${rootMgName}-platform'
  }
  {
    name: '${rootMgName}-operations'
    displayName: '${toUpper(orgName)} ${toUpper(geoPrefix)} Operations'
    parentMgId: '/providers/Microsoft.Management/managementGroups/${rootMgName}-platform'
  }
]

// ==========================================
// Governance & Scoping Configurations
// ==========================================

param requiredTags = [
  'Owner'
  'Environment'
  'CostCenter'
]

param securityBenchmarkEnforcementMode = 'DoNotEnforce' // Easily toggle to 'Default' for strict production enforcement later

param disallowedResourceTypes = [
  'Microsoft.Network/publicIPAddresses'
]

// ==========================================
// Policy Exemptions & Operational Overrides
// ==========================================

param policyExemptions = [
  {
    name: 'exemption-allow-hub-public-ips'
    displayName: 'Allow Public IPs for Connectivity Hub Firewall'
    description: 'Exempts the connectivity subscription from the global public IP restriction to permit Azure Firewall deployment.'
    exemptionCategory: 'Mitigated'
    subscriptionId: '33333333-3333-3333-3333-333333333333'
    targetSlug: 'stg-guard'
  }
]

// ==========================================
// Subscription Associations (Inline & DRY)
// ==========================================
param subscriptionAssociations = [
  {
    mgName: '${rootMgName}-corp'
    subscriptionIds: [
      '11111111-1111-1111-1111-111111111111' // Placeholder: Replace with actual Corp subscription ID
    ]
  }
  {
    mgName: '${rootMgName}-online'
    subscriptionIds: [
      '22222222-2222-2222-2222-222222222222' // Placeholder: Replace with actual Online subscription ID
    ]
  }
  {
    mgName: '${rootMgName}-connectivity'
    subscriptionIds: [
      '33333333-3333-3333-3333-333333333333' // Placeholder: Replace with actual Connectivity subscription ID
    ]
  }
  {
    mgName: '${rootMgName}-identity'
    subscriptionIds: [
      '44444444-4444-4444-4444-444444444444' // Placeholder: Replace with actual Identity subscription ID
    ]
  }
  {
    mgName: '${rootMgName}-operations'
    subscriptionIds: [
      '55555555-5555-5555-5555-555555555555' // Placeholder: Replace with actual Operations subscription ID
    ]
  }
]